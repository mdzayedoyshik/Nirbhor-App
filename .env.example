# Copy to .env.dev (and .env.prod for release builds). Never commit these files.

# Base URL of the Nirbhor API, e.g. http://10.0.2.2:3000 for a local server on the Android emulator
BASE_URL=

# Google OAuth client ID used for Google Sign-In
GOOGLE_CLIENT_ID=

# Optional: prefilled login for local testing only
TEST_MAIL=
TEST_PASSWORD=
